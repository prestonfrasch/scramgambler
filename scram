#!/usr/bin/env python3
import random
import time
import sys

# --- Scrabble scoring (English, standard) ---
SCRABBLE_POINTS = {
    **{c: 1 for c in "AEILNORSTU"},
    **{c: 2 for c in "DG"},
    **{c: 3 for c in "BCMP"},
    **{c: 4 for c in "FHVWY"},
    **{c: 5 for c in "K"},
    **{c: 8 for c in "JX"},
    **{c: 10 for c in "QZ"},
}

# Map each point tier to an emoji "symbol" for the slot
TIER_EMOJI = {
    1: "😀",   # common letter
    2: "😄",
    3: "😎",
    4: "🥳",
    5: "🤩",
    8: "💎",   # rare/high value
    10: "👑",  # rare/highest value
}

# Default (fallback) symbol mix if user enters no valid letters
DEFAULT_POOL = [1,1,1,2,2,3,3,4,5,8,10]

SPIN_FRAMES = ["|", "/", "—", "\\"]

def scrabble_score(word: str) -> int:
    return sum(SCRABBLE_POINTS.get(ch.upper(), 0) for ch in word)

def tier_counts(word: str):
    counts = {k: 0 for k in TIER_EMOJI.keys()}
    for ch in word.upper():
        pts = SCRABBLE_POINTS.get(ch)
        if pts:
            counts[pts] += 1
    return counts

def build_symbol_pool(word: str):
    """
    Build a weighted pool of tier keys (e.g., [1,1,1,2,3,10,...])
    Weighted by how often each tier appears in the word,
    with a small base weight so reels aren't empty if a tier is missing.
    """
    counts = tier_counts(word)
    pool = []
    # Base weight gives everyone a minimum chance; tiers present in the word
    # get extra weight to "reflect the points we get".
    for tier, base_emoji in TIER_EMOJI.items():
        base_weight = 1
        bonus = counts[tier] * 3   # amplify word-driven tiers
        # Extra bias so high tiers still feel rare unless the word has them
        rarity_adjust = {8: -1, 10: -1}.get(tier, 0)
        weight = max(0, base_weight + bonus + rarity_adjust)
        pool.extend([tier] * weight)
    # Fallback if pool got empty for some reason
    if not pool:
        pool = DEFAULT_POOL[:]
    return pool

def spin_reels(pool, reels=3):
    return [random.choice(pool) for _ in range(reels)]

def format_reels(result_tiers):
    return " | ".join(TIER_EMOJI[t] for t in result_tiers)

def spin_animation(duration=0.6):
    # quick little spinner
    steps = int(duration / 0.08)
    for i in range(steps):
        sys.stdout.write("\rSpinning " + SPIN_FRAMES[i % len(SPIN_FRAMES)])
        sys.stdout.flush()
        time.sleep(0.08)
    sys.stdout.write("\r" + " " * 20 + "\r")

def evaluate_spin(word_score, result_tiers):
    """
    Payout rules:
      - Base payout = word_score
      - + Multipliers:
          * 3 of a kind -> x5
          * 2 of a kind -> x2
          * all different -> x1
      - + High-tier bonus: +3 for each 💎 (8) and +5 for each 👑 (10)
    Returns (payout, breakdown_string)
    """
    a, b, c = result_tiers
    multiplier = 1
    if a == b == c:
        kind = "3 of a kind"
        multiplier = 5
    elif a == b or a == c or b == c:
        kind = "2 of a kind"
        multiplier = 2
    else:
        kind = "all different"
        multiplier = 1

    high_bonus = sum(3 for t in result_tiers if t == 8) + sum(5 for t in result_tiers if t == 10)
    payout = max(0, word_score) * multiplier + high_bonus

    breakdown = (
        f"Word score: {word_score} | Result: {kind} (x{multiplier}) | "
        f"High-tier bonus: +{high_bonus}"
    )
    return payout, breakdown

def explain_word(word):
    parts = []
    total = 0
    for ch in word.upper():
        pts = SCRABBLE_POINTS.get(ch, 0)
        if pts:
            parts.append(f"{ch}={pts}")
            total += pts
        else:
            parts.append(f"{ch}=0")
    return f"{' + '.join(parts)} = {total}"

def play_once(word: str):
    word = word.strip()
    if not word:
        print("Enter a word with A–Z letters.")
        return

    score = scrabble_score(word)
    pool = build_symbol_pool(word)

    print("\n=== SCRABBLE SLOTS ===")
    print(f"Your word: {word}  ({explain_word(word)})")
    print("Reels weighted by your word's point tiers.\n")

    spin_animation()
    result_tiers = spin_reels(pool, 3)
    reels_str = format_reels(result_tiers)
    print(f"Result: {reels_str}")

    payout, breakdown = evaluate_spin(score, result_tiers)
    print(breakdown)
    print(f"Payout: {payout}\n")

def main():
    print("Scrabble Emoji Slot Machine 🎰")
    print("Type a word to score it like Scrabble, then spin reels with emojis reflecting your points.")
    print("Letters/tiers map to emojis:")
    print("  1😀  2😄  3😎  4🥳  5🤩  8💎  10👑")
    print("Enter blank line to quit.\n")
    while True:
        try:
            word = input("Enter a word (A–Z): ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nGoodbye!")
            return
        if not word:
            print("Goodbye!")
            return
        play_once(word)

if __name__ == "__main__":
    main()
